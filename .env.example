AZURE_AI_PROJECT_ENDPOINT=https://<account>.services.ai.azure.com/api/projects/<project>   # platform output: foundryProjectEndpoint
AZURE_AI_MODEL_DEPLOYMENT_NAME=gpt-4.1   # must exist in platform param foundryDeployments
ACR_LOGIN_SERVER=<acr>.azurecr.io   # platform output: acrLoginServer (deploy script only)
STORAGE_ACCOUNT_URL=https://<storage>.blob.core.windows.net   # optional; analyst uploads generated files here (container agent-files)
